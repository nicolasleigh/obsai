# Copy this file to .env and fill in the value locally.
# Never commit .env or share this key.

# Required for remote embeddings, semantic search, answering, and agent planning.
OPENAI_API_KEY=

# Optional: override the configuration file discovered by ObsAI.
# OBSAI_CONFIG_PATH=

# Optional: development server settings (Makefile values take precedence).
# OBSAI_UI_HOST=127.0.0.1
# OBSAI_UI_PORT=8000
# OBSAI_UI_NO_RELOAD=0
# OBSAI_UI_NO_WEB=0
